{
  "description": "Rangos orientativos para simulaciones Zerlaut-AdEx de una región. El programa de ejemplo no lee este fichero.",
  "units": {
    "time": "ms",
    "rate": "Hz",
    "adaptation_current": "pA",
    "voltage": "mV",
    "conductance": "nS"
  },
  "simulation": {
    "duration_ms": {"min": 100.0, "max": 20000.0, "default": 4000.0},
    "dt_ms": {"min": 0.05, "max": 1.0, "default": 0.5},
    "method": {"allowed": ["euler", "heun"], "default": "heun"},
    "initial_state": {
      "E_hz": {"min": 0.0, "max": 5000.0, "default": 0.0},
      "I_hz": {"min": 0.0, "max": 5000.0, "default": 0.0},
      "W_e_pA": {"min": -100000.0, "max": 100000.0, "default": 0.0},
      "W_i_pA": {"min": -100000.0, "max": 100000.0, "default": 0.0}
    }
  },
  "external_drive": {
    "scale": {"min": 0.0, "max": 3.0, "default": 1.0, "sampling": "linear"},
    "Fi_ratio": {"min": 0.0, "max": 2.5, "default": 0.5, "sampling": "linear"}
  },
  "model_parameters": {
    "g_L": {"min": 0.1, "max": 100.0, "default": 10.0, "unit": "nS"},
    "C_m": {"min": 10.0, "max": 500.0, "default": 200.0, "unit": "pF"},
    "E_L_e": {"min": -70.0, "max": -50.0, "default": -60.0, "unit": "mV"},
    "E_L_i": {"min": -75.0, "max": -55.0, "default": -65.0, "unit": "mV"},
    "a_e": {"min": 0.0, "max": 8.0, "default": 4.0, "unit": "nS"},
    "b_e": {"min": 0.0, "max": 200.0, "default": 60.0, "unit": "pA"},
    "tau_w_e": {"min": 20.0, "max": 400.0, "default": 200.0, "unit": "ms", "sampling": "log"},
    "a_i": {"min": 0.0, "max": 6.0, "default": 0.0, "unit": "nS"},
    "b_i": {"min": 0.0, "max": 120.0, "default": 20.0, "unit": "pA"},
    "tau_w_i": {"min": 20.0, "max": 400.0, "default": 100.0, "unit": "ms", "sampling": "log"},
    "E_e": {"min": -20.0, "max": 20.0, "default": 0.0, "unit": "mV"},
    "E_i": {"min": -100.0, "max": -60.0, "default": -80.0, "unit": "mV"},
    "Q_e": {"min": 0.5, "max": 2.5, "default": 1.0, "unit": "nS", "sampling": "log"},
    "Q_i": {"min": 2.0, "max": 8.0, "default": 5.0, "unit": "nS", "sampling": "log"},
    "tau_e": {"min": 2.0, "max": 8.0, "default": 5.0, "unit": "ms", "sampling": "log"},
    "tau_i": {"min": 2.0, "max": 12.0, "default": 5.0, "unit": "ms", "sampling": "log"},
    "N_tot": {"min": 1000, "max": 50000, "default": 10000, "integer": true},
    "p_connect_e": {"min": 0.001, "max": 0.2, "default": 0.05},
    "p_connect_i": {"min": 0.001, "max": 0.2, "default": 0.05},
    "g": {"min": 0.1, "max": 0.45, "default": 0.2},
    "K_ext_e": {"min": 100, "max": 900, "default": 400, "integer": true, "sampling": "log"},
    "K_ext_i": {"min": 0, "max": 400, "default": 35, "integer": true},
    "T": {"min": 2.0, "max": 20.0, "default": 10.0, "unit": "ms", "sampling": "log"}
  },
  "stimulus": {
    "type": {
      "allowed": ["constant", "step", "pulse", "slow_ramp", "double_pulse", "recovery", "sine", "ou_like"],
      "default": "pulse"
    },
    "baseline_hz": {"min": 0.0, "max": 40.0, "default": 5.0},
    "amplitude_hz": {"min": 0.0, "max": 120.0, "default": 40.0},
    "onset_ms": {"min": 0.0, "max": 20000.0, "default": 500.0},
    "duration_ms": {"min": 0.05, "max": 20000.0, "default": 1000.0},
    "inter_pulse_interval_ms": {"min": 0.0, "max": 10000.0, "default": 500.0},
    "second_amplitude_hz": {"min": 0.0, "max": 120.0, "default": 30.0},
    "frequency_hz": {"min": 0.01, "max": 100.0, "default": 2.0},
    "phase_rad": {"min": 0.0, "max": 6.283185307179586, "default": 0.0},
    "ou_tau_ms": {"min": 0.05, "max": 5000.0, "default": 50.0},
    "ou_sigma_hz": {"min": 0.0, "max": 120.0, "default": 5.0},
    "seed": {"min": 0, "max": 4294967295, "default": 123, "integer": true}
  }
}
